rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if current authenticated user is Riyaj Sk (xriyajsk@gmail.com)
    // or verified admin request key for domain flexibility
    function isRiyajAdmin() {
      return (request.auth != null && request.auth.token.email.lower() == 'xriyajsk@gmail.com') ||
             (request.resource.data.adminKey == 'riyaj-admin-2025');
    }

    // Public read access for portfolio content; write access only for xriyajsk@gmail.com
    match /portfolio/{document} {
      allow read: if true;
      allow write: if isRiyajAdmin();
    }

    // Contact form submissions: any client can create/submit messages; only admin can view/manage
    match /messages/{messageId} {
      allow create: if request.resource.data.email is string && request.resource.data.message is string;
      allow read, update, delete: if isRiyajAdmin();
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
